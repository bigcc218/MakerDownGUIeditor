#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// Version resource. Keep the numeric fields and the string block in sync when
// bumping a release; FILEVERSION/ PRODUCTVERSION are 4x uint16.
#define MDGE_VERSION_MAJOR 1
#define MDGE_VERSION_MINOR 1
#define MDGE_VERSION_PATCH 2
#define MDGE_VERSION_BUILD 0

#define MDGE_VERSION_STRING "1.1.2"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MDGE_VERSION_MAJOR,MDGE_VERSION_MINOR,MDGE_VERSION_PATCH,MDGE_VERSION_BUILD
 PRODUCTVERSION MDGE_VERSION_MAJOR,MDGE_VERSION_MINOR,MDGE_VERSION_PATCH,MDGE_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "bigcc218"
            VALUE "FileDescription", "MDGE Studio 可视化 Markdown 编辑器"
            VALUE "FileVersion", MDGE_VERSION_STRING
            VALUE "InternalName", "MDGEStudio"
            VALUE "LegalCopyright", "Copyright (c) 2026 bigcc218"
            VALUE "OriginalFilename", "MDGEStudio.exe"
            VALUE "ProductName", "MDGE Studio"
            VALUE "ProductVersion", MDGE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
